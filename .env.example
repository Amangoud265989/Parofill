# ==============================================================================
# ParroFill — Environment Configuration Template
# Safe placeholder values only — do NOT commit real secrets or production keys.
# ==============================================================================

# Node Environment
NODE_ENV="development"
PORT="3000"

# Application Base URL (Used for extension CORS, redirect links, and webhook verifications)
APP_URL="http://localhost:3000"

# Gemini AI API Configuration
# In Google AI Studio, this is injected automatically from user secrets.
# For self-hosted production (e.g. Hostinger, VPS, Cloud Run), obtain from Google AI Studio.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# Authentication & Session Security
# Generate a cryptographically random 64-character secret for production:
# e.g., node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY_FOR_JWT_SIGNING"
SESSION_EXPIRY_DAYS="30"

# Database Storage
# ParroFill utilizes high-performance persistent SQLite with WAL mode by default.
DATABASE_FILE="./data/parrofill.sqlite"

# Payment & Subscription Processing (Stripe or equivalent provider)
# In development/test mode, use test keys prefixed with sk_test_
STRIPE_SECRET_KEY="sk_test_placeholder_key_for_testing"
STRIPE_WEBHOOK_SECRET="whsec_placeholder_webhook_signing_secret"

# Allowed CORS Origins (Comma-separated list for Chrome extension and web clients)
ALLOWED_ORIGINS="http://localhost:3000,chrome-extension://"
